# Canonical site URL — used for metadata, Open Graph, JSON-LD, sitemap & robots.
# Set this to your custom domain once you have one (e.g. https://dataforge.app).
# If unset, falls back to the Vercel production URL automatically.
NEXT_PUBLIC_SITE_URL=

# Google reCAPTCHA v3 site key (public). Leave blank to disable.
# Pair with a server-side secret (RECAPTCHA_SECRET) to verify tokens.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable.
# GA only loads in production when this is set.
NEXT_PUBLIC_GA_ID=

# Copy to .env.local and fill in to enable error monitoring (optional).
# Without these, the app builds and runs normally with Sentry disabled.

# Public DSN from your Sentry project (Settings → Client Keys).
NEXT_PUBLIC_SENTRY_DSN=

# Only needed to upload source maps during build (CI / production).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
