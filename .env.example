# Copy to .env.local and fill in to enable error monitoring (optional).
# Without these, the app builds and runs normally with Sentry disabled.

# Public DSN from your Sentry project (Settings → Client Keys).
NEXT_PUBLIC_SENTRY_DSN=

# Only needed to upload source maps during build (CI / production).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
